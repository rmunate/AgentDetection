{
    "name": "rmunate/agent-detection",
    "description": "Detect devices, browsers, operating systems, and crawlers from the user agent, with Laravel Blade directives.",
    "keywords": [
        "laravel",
        "php",
        "agent"
    ],
    "homepage": "https://github.com/rmunate/AgentDetection",
    "support": {
        "docs": "https://rmunate.github.io/AgentDetection/"
    },
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Rmunate\\AgentDetection\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Raul Mauricio Uñate Castro",
            "email": "raulmauriciounate@gmail.com",
            "homepage": "https://github.com/rmunate",
            "role": "owner"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "jaybizzle/crawler-detect": "^1.2",
        "mobiledetect/mobiledetectlib": "^4.8"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.5"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "analyse": "@php vendor/bin/phpstan analyse --level=5 --no-progress src"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rmunate\\AgentDetection\\Providers\\AgentProvider"
            ]
        }
    }
}
